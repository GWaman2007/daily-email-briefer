# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# AI & Search APIs
GEMINI_API_KEY=your-google-gemini-api-key
TAVILY_API_KEY=your-tavily-search-api-key

# Outbound Email Delivery (Gmail SMTP Relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-16-char-app-password
RECIPIENT_EMAIL=your-destination-email@example.com

# Optional Model & Search Overrides (Can also be set in Supabase profile)
PRIMARY_MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.1-flash-lite
SEARCH_TOPIC=news
SEARCH_DEPTH=basic
MAX_SEARCH_QUERIES=4
